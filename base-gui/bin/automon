#!/bin/sh

CFG="${XDG_CONFIG_HOME:-$HOME/.config}/automonrc.sh"

saved=''

run() {
    printf '\033[1;32m$\033[0m %s\n' "$*" >&2
    eval "$*"
}

run_if_exists() {
    if command -v "$1" >/dev/null; then
        run "$@"
    fi
}

notify() {
    notify-send "Display" "$1"
}

current_sum() {
    xrandr --verbose   |
        grep -A 8 EDID |
        md5sum         |
        cut -d ' ' -f1
}

save() {
    # save <sum> <name-no-space> <xrandr command>
    saved="$saved$*
"
}

load() {
    sum="$1"
    echo "$saved" | grep "^$sum" | tail -n1
}

pre() {
    # to be overridden in the rc file
    :
}

post() {
    # to be overridden in the rc file
    :
}

handle() {
    mode="$1"
    [ -n "$mode" ] || mode=auto

    allow_notif=1
    [ "$2" = '--no-notif' ] && allow_notif= && shift

    randr=$(xrandr --verbose)

    best_dim_of() {
        # too hacky, TODO: find a better way?
        echo "$randr"                             |
            grep -A 9999 "^$1"                    |
            sed -rn 's/  ([0-9]+x[0-9]+) .+/\1/p' |
            head -n1
    }

    outs_con=$(echo "$randr" |
                   sed -rn 's/^([A-Za-z0-9\-]+) connected .+/\1/p' |
                   while read -r o; do
                       printf '%s %s\n' "$(best_dim_of "$o")" "$o"
                   done)
    outs_dis=$(echo "$randr" |
                   sed -rn 's/^([A-Za-z0-9\-]+) disconnected .+/\1/p')

    out_first=$(echo "$outs_con" | head -n1 | cut -d ' ' -f2)
    out_largest=$(echo "$outs_con" | sort -rn | head -n1 | cut -d ' ' -f2)

    sum=$(current_sum)
    saved_cmd=$(load "$sum")

    cmd="xrandr"

    OLD_IFS="$IFS"
    IFS='
'

    cmd_off=$cmd
    for out in $outs_con; do
        out=$(echo "$out" | cut -d ' ' -f2)
        if [ "$out" = "$out_first" ]; then
            cmd_off="$cmd_off --output $out --auto --primary"
        else
            cmd_off="$cmd_off --output $out --off"
        fi
    done

    if [ "$mode" = auto ] && [ -n "$saved_cmd" ]; then
        mode=$(echo "$saved_cmd" | cut -d ' ' -f2)
        cmd=$(echo "$saved_cmd"  | cut -d ' ' -f3-)

    else
        for out in $outs_dis; do
            cmd="$cmd --output $out --off"
        done

        case "$mode" in
            extend|auto)
                # the largest is the primary; align from left to right with normal rotation
                prev_w=0
                for out in $outs_con; do
                    dim=$(echo "$out" | cut -d ' ' -f1)
                    wid=$(echo "$out" | cut -d 'x' -f1)
                    out=$(echo "$out" | cut -d ' ' -f2)
                    cmd="$cmd --output $out --rotate normal --mode $dim --pos ${prev_w}x0"
                    prev_w=$((prev_w + wid))
                    if [ "$out" = "$out_largest" ]; then
                        cmd="$cmd --primary"
                    fi
                done ;;

            mirror)
                # the first is the primary; all like the primary
                out_target=$out_first
                dim=$(echo "$outs_con" | sed -rn "s/^(.+) $out_target/\1/p")
                for out in $outs_con; do
                    out=$(echo "$out" | cut -d ' ' -f2)
                    if [ "$out" = "$out_target" ]; then
                        cmd="$cmd --output $out --rotate normal --mode $dim --pos 0x0 --primary"
                    else
                        cmd="$cmd --output $out --same-as $out_target --scale-from $dim"
                    fi
                done ;;

            *)
                echo "ERROR: unknown mode '$mode'"
                return 1
        esac
    fi

    IFS="$OLD_IFS"

    pre

    run "$cmd" || {
        run "$cmd_off"
        run "$cmd"
    }

    [ -n "$allow_notif" ] && notify "$mode"

    post
}

now() {
    date +%s%3N
}

lowpass() {
    # prints the last line in the range of `debounce_time` seconds,
    # defaults to 1 second
    debounce_time="${1:-1}"
    tmpfile=$(mktemp)
    genfile=$(mktemp)
    echo 0 > "$genfile"
    trap 'rm -f "$tmpfile" "$genfile"' EXIT INT TERM

    while IFS= read -r line; do
        gen=$(( $(cat "$genfile") + 1 ))
        echo "$gen"  > "$genfile"
        echo "$line" > "$tmpfile"
        ( my_gen="$gen"
          sleep "$debounce_time"
          [ "$(cat "$genfile")" = "$my_gen" ] && cat "$tmpfile"
        ) &
    done
    wait
}

daemon() {
    udevadm monitor | while read -r line; do
        if echo "$line" | grep -Eq 'UDEV.+\(drm\)'; then
            echo "$(date) $line"
        fi
    done          |
        lowpass 2 |
        while read -r line; do
            echo "$line"
            handle
        done
}

current_xrandr() {
    xrandr | awk '
      / connected/ {
          output=$1

          if ($0 ~ / connected primary /)
              primary="--primary"
          else
              primary=""

          rotate="normal"

          for (i=1; i<=NF; i++) {
              if ($i ~ /\(normal|left|right|inverted/) {
                  gsub(/[()]/, "", $i)
                  rotate=$i
              }

              if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) {
                  split($i,a,"+")
                  split(a[1],r,"x")

                  printf "--output %s %s --mode %sx%s --pos %sx%s ",
                         output,
                         primary,
                         r[1], r[2],
                         a[2], a[3]

                  if (rotate != "normal")
                      printf "--rotate %s ", rotate

                  found=1
              }
          }

          if (!found)
              printf "--output %s --off ", output

          found=0
      }

      END { print "" }'
}

current_save() {
    if [ $# = 1 ]; then
        n=$1
    else
        n=mon-$(date '+%Y%m%d%H%M%S')
    fi
    s=$(current_sum)
    opts=$(current_xrandr)
    if [ -f "$CFG" ]; then
        grep -Eq "^save ${s}( |$)" "$CFG" && {
            echo 'ERROR: config sum already exists'
            return 1
        }
        grep -Eq "^save [^ ]+ ${n}( |$)" "$CFG" && {
            echo 'ERROR: config name already exists'
            return 1
        }
    fi
    printf 'save %s %s xrandr \\\n    %s\n\n' "$s" "$n" "$opts" \
           >> "$CFG"
}

arandr_save() {
    if [ $# = 1 ]; then
        f=$1
    else
        # latest
        f=$(ls -1t ~/.screenlayout/*.sh 2>/dev/null | head -n1)
    fi

    [ -f "$f" ] || {
        echo "ERROR: no arandr script found"
        return 1
    }

    n=$(basename "$f" .sh)
    opts=$(sed -rn 's/xrandr (.+)/\1/p' "$f")

    [ -n "$opts" ] || {
        echo "ERROR: failed to extract xrandr command"
        return 1
    }

    s=$(current_sum)

    if [ -f "$CFG" ]; then
        grep -Eq "^save ${s}( |$)" "$CFG" && {
            echo 'ERROR: config sum already exists'
            return 1
        }

        grep -Eq "^save [^ ]+ ${n}( |$)" "$CFG" && {
            echo 'ERROR: config name already exists'
            return 1
        }
    fi

    printf 'save %s %s xrandr \\\n    %s\n\n' \
           "$s" "$n" "$opts" >> "$CFG"
}

main() {
    [ -e "$CFG" ] && . "$CFG"

    case "$1" in
        sum)                       current_sum       ;;
        save)               shift; current_save "$@" ;;
        asave)              shift; arandr_save  "$@" ;;
        auto|extend|mirror)        handle       "$@" ;;
        daemon)                    daemon            ;;
        *)
            echo 'ERROR: unknown args'
            return 1
    esac
}

main "$@"
